# Standalone AutoMap Agent Configuration
# Copy to .env when deploying on a server or customizing ports/URLs.

# --- Local Docker mode (default) ---
AGENT_PORT=4000
AUTOMAP_URL=http://host.docker.internal:3000
AUTOMAP_PUBLIC_URL=http://localhost:3000

# --- Server / VPS deployment mode ---
# Set AGENT_SERVER=TRUE and AGENT_WEB_PASSWORD to protect the agent dashboard with login.
# AGENT_SERVER=TRUE
# AGENT_WEB_USERNAME=admin
# AGENT_WEB_PASSWORD=change-me-strong-password
# AGENT_SECRET_KEY=replace-with-random-hex-secret
# AUTOMAP_URL=https://your-automap-domain.com
# AUTOMAP_PUBLIC_URL=https://your-automap-domain.com
# WEB_LOGIN=your-automap-login
# WEB_PASSWORD=your-automap-password
# AGENT_YOUTUBE_REDIRECT_URI=https://your-agent-domain.com/api/agent/youtube/callback
# AGENT_BIND_ADDRESS=127.0.0.1

# Optional env fallbacks (you can also enter all of these directly in the web UI):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# YOUTUBE_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# AGENT_ENABLED=TRUE
