GEMINI_API_KEY=your_google_ai_studio_key
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional real web search for DeepSeek: tavily or brave (separate service key).
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=your_tavily_api_key
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# Local mode is the default. Set TRUE only in the server deployment .env.
SERVER=FALSE
# WEB_LOGIN=your-username
# WEB_PASSWORD=choose-a-unique-password
# Optional host binding for Docker. Loopback is the default.
# AUTOMAP_BIND_ADDRESS=127.0.0.1
# Server mode uses Secure cookies by default. For trusted HTTP-only deployments:
# WEB_COOKIE_SECURE=FALSE
# Optional stable session signing secret; otherwise generated in instance/.
# WEB_SECRET_KEY=replace-with-a-long-random-secret

# Optional external HTTPS callback URL when AutoMap runs behind a reverse proxy.
# YOUTUBE_REDIRECT_URI=https://automap.example.com/api/youtube/callback

# Optional public URL for the standalone AutoMap Agent.
# AGENT_URL=http://localhost:4000
